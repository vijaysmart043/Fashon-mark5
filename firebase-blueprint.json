        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "active"]
    },
    "Address": {
      "title": "Address",
      "description": "Customer delivery address",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "maxLength": 120 },
        "mobile": { "type": "string", "maxLength": 16, "pattern": "^[0-9+\\- ]{10,16}$" },
        "addressLine": { "type": "string", "maxLength": 300 },
        "city": { "type": "string", "maxLength": 80 },
        "state": { "type": "string", "maxLength": 80 },
        "pincode": { "type": "string", "maxLength": 10, "pattern": "^[0-9]{6}$" },
        "addressType": { "type": "string", "enum": ["Home", "Work", "Other"] },
        "isDefault": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "fullName", "mobile", "addressLine", "city", "state", "pincode", "addressType", "isDefault"]
    },
    "Cart": {
      "title": "Cart",
      "description": "Authenticated customer shopping bag",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "items": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "items"]
    },
    "Wishlist": {
      "title": "Wishlist",
      "description": "Customer saved product IDs",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productIds": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "productIds"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category definition",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 80 },
        "slug": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 500 },
        "image": { "type": "string", "maxLength": 500 },
        "itemCount": { "type": "number" },
        "active": { "type": "boolean" },
        "returnEligible": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "slug", "active"]
    },
    "Product": {
      "title": "Product",
      "description": "Storefront product record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 160 },
        "slug": { "type": "string", "maxLength": 160 },
        "category": { "type": "string", "maxLength": 80 },
        "type": { "type": "string", "enum": ["jewellery", "saree", "dress", "fashion"] },
        "basePrice": { "type": "number" },
        "discount": { "type": "number" },
        "active": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "bestseller": { "type": "boolean" },
        "newArrival": { "type": "boolean" },
        "returnable": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "slug", "category", "type", "basePrice", "active"]
    },
    "ProductVariant": {
      "title": "ProductVariant",
      "description": "Variant SKU inventory record",
      "type": "object",
      "properties": {
        "sku": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "colour": { "type": "string", "maxLength": 80 },
        "size": { "type": "string", "maxLength": 80 },
        "weight": { "type": "string", "maxLength": 40 },
        "stock": { "type": "number" },
        "price": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sku", "productId", "stock", "price"]
    },
    "MetalRate": {
      "title": "MetalRate",
      "description": "Gold and silver rate per gram",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "metal": { "type": "string", "maxLength": 32 },
        "purity": { "type": "string", "maxLength": 32 },
        "ratePerGram": { "type": "number" },
        "currency": { "type": "string", "maxLength": 8 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "metal", "purity", "ratePerGram", "currency"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Promotional coupon record with optional usage and expiry rules",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 32, "pattern": "^[A-Z0-9_\\-]+$" },
        "discountPercent": { "type": "number" },
        "minOrderAmount": { "type": "number" },
        "maxDiscountAmount": { "type": "number" },
        "usageCount": { "type": "number" },
        "usageLimit": { "type": "number" },
        "expiresAt": { "type": "string", "maxLength": 40 },
        "description": { "type": "string", "maxLength": 200 },
        "active": { "type": "boolean" }
      },
      "required": ["code", "discountPercent", "active"]
    },
    "HeroBanner": {
      "title": "HeroBanner",
      "description": "Storefront hero and promotional banner slide",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 160 },
        "subtitle": { "type": "string", "maxLength": 300 },
        "badge": { "type": "string", "maxLength": 80 },
        "image": { "type": "string", "maxLength": 500 },
        "ctaPrimary": { "type": "string", "maxLength": 60 },
        "ctaSecondary": { "type": "string", "maxLength": 60 },
        "targetTab": { "type": "string", "maxLength": 40 },
        "displayOrder": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "subtitle", "image", "displayOrder", "active"]
    },
    "StockReservation": {
      "title": "StockReservation",
      "description": "Temporary checkout inventory reservation window",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "items": { "type": "array" },
        "status": { "type": "string", "enum": ["active", "converted", "expired", "released"] },
        "expiresAt": { "type": "string", "maxLength": 64 },
        "orderId": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "items", "status", "expiresAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app customer notification for orders, payments, shipments, returns, and refunds",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["order_confirmation", "payment_result", "order_status_update", "shipment_update", "return_update", "refund_update", "account_notification"] },
        "title": { "type": "string", "maxLength": 160 },
        "message": { "type": "string", "maxLength": 600 },
        "orderNumber": { "type": "string", "maxLength": 32 },
        "read": { "type": "boolean" },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "type", "title", "message", "read"]
    },
    "EmailLog": {
      "title": "EmailLog",
      "description": "Resend transactional email delivery request log without secrets",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "requestId": { "type": "string", "maxLength": 64 },
        "resendEmailId": { "type": "string", "maxLength": 128 },
        "idempotencyKey": { "type": "string", "maxLength": 250 },
        "templateType": { "type": "string", "enum": ["welcome", "email_verification", "password_reset", "order_confirmation", "payment_status", "invoice_notification", "shipment_update", "return_update", "refund_update"] },
        "recipientEmail": { "type": "string", "maxLength": 160 },
        "userId": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "enum": ["queued", "sent_to_provider", "delivered", "delivery_delayed", "bounced", "complained", "failed", "skipped_unconfigured"] },
        "lastEvent": { "type": "string", "maxLength": 64 },
        "statusNote": { "type": "string", "maxLength": 400 },
        "errorCode": { "type": "string", "maxLength": 64 },
        "errorMessage": { "type": "string", "maxLength": 300 },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "requestId", "idempotencyKey", "templateType", "recipientEmail", "status"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order with payment and delivery tracking metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerName": { "type": "string", "maxLength": 120 },
        "customerEmail": { "type": "string", "maxLength": 160 },
        "orderNumber": { "type": "string", "maxLength": 32, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discountAmount": { "type": "number" },
        "couponCode": { "type": "string", "maxLength": 32 },
        "shippingFee": { "type": "number" },
        "gstAmount": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Confirmed & Packed", "Processing", "Shipped", "Out for Delivery", "Delivered", "Delivery Failed", "Returned to Sender", "Return Requested", "Return Approved", "Refund Initiated", "Refunded", "Cancelled"] },
        "paymentMethod": { "type": "string", "enum": ["upi", "card", "netbanking", "wallet", "cod", "UPI", "Card", "COD"] },
        "paymentStatus": { "type": "string", "enum": ["Successful", "Pending COD", "Failed", "Refunded", "Partially Refunded"] },
        "shippingAddress": { "type": "object" },
        "shipmentId": { "type": "string", "maxLength": 64 },
        "deliveredAt": { "type": "string", "maxLength": 64 },
        "stockReserved": { "type": "boolean" },
        "stockRestored": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "orderNumber", "items", "total", "status", "paymentMethod", "paymentStatus"]
    },
    "PaymentRecord": {
      "title": "PaymentRecord",
