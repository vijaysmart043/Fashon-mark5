        "orderNumber": { "type": "string", "maxLength": 32 },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerName": { "type": "string", "maxLength": 120 },
        "courierId": { "type": "string", "maxLength": 64 },
        "courierName": { "type": "string", "maxLength": 80 },
        "trackingNumber": { "type": "string", "maxLength": 80 },
        "trackingUrl": { "type": "string", "maxLength": 300 },
