        "status": { "type": "string", "enum": ["Shipment Created", "Ready for Pickup", "Picked Up", "In Transit", "Reached Destination Hub", "Out for Delivery", "Delivered", "Delivery Attempt Failed", "Returned to Sender", "Shipment Cancelled"] },
        "deliveryNotes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orderId", "orderNumber", "userId", "courierName", "status"]
    },
    "ShipmentEvent": {
      "title": "ShipmentEvent",
